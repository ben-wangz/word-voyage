{
  "name": "wordvoyage-backend",
  "version": "1.0.0",
  "description": "WordVoyage - AI-driven sandbox adventure game backend",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "type-check": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "i18next": "^23.15.1",
    "i18next-fs-backend": "^2.3.2",
    "ioredis": "^5.8.2",
    "js-tiktoken": "^1.0.21",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
